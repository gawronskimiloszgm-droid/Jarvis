# Agent kamer - dziala na laptopie, nie na Render. Skopiuj do .env i wypelnij.

# Adres appki w chmurze (Render) albo http://localhost:3000 przy teście lokalnym.
JARVIS_URL=https://jarvis-u4vw.onrender.com

# Te same dane logowania co w przegladarce.
OWNER_USER=
OWNER_PASSWORD=

# Nazwa tej kamery - pojawi sie w alertach i dzienniku ("garaz: widac osobe").
CAMERA_NAME=garaz

# Adres strumienia RTSP kamery, np. rtsp://user:haslo@192.168.1.50:554/stream1
RTSP_URL=

# Czulosc wykrywania ruchu (0-1). Nizej = wiecej falszywych trafien
# (wiatr, cienie), wyzej = mozna przegapic powolny ruch. 0.02 to rozsadny start.
SCENE_THRESHOLD=0.02

# Co ile ms potwierdzac, ze polaczenie zyje (domyslnie 5 minut).
HEARTBEAT_MS=300000

# Sciezka do ffmpeg, jesli nie jest w PATH systemowym.
FFMPEG_BIN=ffmpeg

# --- Monitor maszyny (system-monitor.js) ---
# Nazwa tej maszyny w interfejsie. Domyslnie nazwa hosta.
MACHINE_NAME=

# Co ile ms wysylac odczyt obciazenia.
TELEMETRY_INTERVAL_MS=20000
