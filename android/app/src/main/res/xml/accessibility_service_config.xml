<?xml version="1.0" encoding="utf-8"?>
<!-- Konfiguracja uslugi dostepnosci Jarvisa.
     Celowo waska: nie nasluchujemy zdarzen (typeWindowStateChanged to
     minimum wymagane przez system), nie zbieramy niczego w tle. Odczyt
     zawartosci okna jest wlaczony, bo bez niego nie da sie znalezc
     przycisku po napisie - ale uzywamy go wylacznie w momencie wykonania
     polecenia, nigdy nie wysylamy zawartosci ekranu na zewnatrz. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="100"
    android:description="@string/accessibility_description" />
