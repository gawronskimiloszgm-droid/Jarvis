# Klucz do Google Gemini (mozg Jarvisa) - wymagany, darmowy tier na https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini do uzycia
GEMINI_MODEL=gemini-flash-lite-latest

# Glos Jarvisa - Microsoft Edge Read Aloud (w pelni darmowe, bez klucza, bez limitu)
# Domyslnie polski meski glos. Inne przyklady: en-GB-RyanNeural (brytyjski), pl-PL-ZofiaNeural (kobiecy)
# Pelna liste zobacz: node scripts/list-voices.js
TTS_VOICE=pl-PL-MarekNeural

# Imie/tytul, ktorym Jarvis zwraca sie do Ciebie
OWNER_TITLE=sir

# Port serwera (Render nadpisze to automatycznie)
PORT=3000
