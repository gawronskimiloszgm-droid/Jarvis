# Klucz do Google Gemini (mozg Jarvisa) - wymagany, darmowy tier na https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Osobny klucz dla E.D.I.T.H. (modul bezpieczenstwa) - opcjonalny. Pusty =
# Edith dzieli klucz z Jarvisem. Osobny klucz = osobny darmowy limit
# zapytan/minute, wiec intensywna rozmowa z jednym z nich nie odbiera
# drugiemu mozliwosci odpowiedzi.
EDITH_GEMINI_API_KEY=

# Glos E.D.I.T.H. przez Gemini TTS - inny niz glos Jarvisa, zeby rozmowa z
# nia brzmiala jak z kims innym. Dowolna nazwa glosu Gemini (np. Charon,
# Puck, Kore...) - pelna liste znajdziesz w dokumentacji Gemini TTS.
EDITH_TTS_VOICE=Charon

# Model Gemini do uzycia
GEMINI_MODEL=gemini-3.7-flash

# Mocniejsi agenci do programowania. Puste = Jarvis robi to sam.
# CODER_AGENT: auto, grok albo claude
XAI_API_KEY=
ANTHROPIC_API_KEY=
CODER_AGENT=auto

# Glos Jarvisa - Microsoft Edge Read Aloud (w pelni darmowe, bez klucza, bez limitu)
# Domyslnie polski meski glos. Inne przyklady: en-GB-RyanNeural (brytyjski), pl-PL-ZofiaNeural (kobiecy)
# Pelna liste zobacz: node scripts/list-voices.js
TTS_VOICE=pl-PL-MarekNeural

# Imie/tytul, ktorym Jarvis zwraca sie do Ciebie
OWNER_TITLE=sir

# --- Konta ---
# Haslo wlasciciela. BEZ NIEGO caly serwer dziala wylacznie w trybie goscia:
# rozmowa, pogoda i wyszukiwanie dzialaja, ale pamiec, zadania, przypomnienia,
# kamera i sterowanie urzadzeniem sa niedostepne dla wszystkich.
OWNER_PASSWORD=

# Sekret do podpisywania tokenow sesji. Jesli pusty, wyprowadzany jest z hasla -
# ustaw wlasny (losowy ciag), jesli chcesz uniewaznic sesje bez zmiany hasla.
SESSION_SECRET=

# Glos rozmowy na zywo (jeden z gotowych glosow Gemini, za darmo).
# Kandydaci pod Jarvisa: Orion (gleboki, niski), Charon (rzeczowy),
# Orus (stanowczy), Sadaltager (erudycyjny), Gacrux (dojrzaly),
# Iapetus (czysty).
# UWAGA przy zmianie: bledna nazwa glosu NIE zglasza bledu - rozmowa
# wstaje normalnie, tylko nie slychac ani slowa. Po zmianie sprawdz,
# czy Jarvis faktycznie sie odzywa.
GEMINI_LIVE_VOICE=Orion

# Model rozmowy na zywo. 3.1 jest ~20x szybszy od 2.5 w czasie do pierwszego
# dzwieku (zmierzone: 63 ms vs 1298 ms sredniej).
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Po ilu ms ciszy Jarvis moze sam zabrac glos podczas rozmowy na zywo.
JARVIS_PROACTIVE_IDLE_MS=45000

# Port serwera (Render nadpisze to automatycznie)
PORT=3000

# Web Push (powiadomienia push) - wygeneruj: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com

# Sekret zabezpieczajacy endpoint /api/cron/tick (wymyslony losowy ciag znakow)
CRON_SECRET=

# --- Kalendarz Google ---
# Puste = "pokaz kalendarz"/"dodaj wydarzenie" po prostu powiedza, ze
# kalendarz nie jest polaczony.
# 1) W Google Cloud Console (console.cloud.google.com) zaloz projekt,
#    wlacz "Google Calendar API", utworz OAuth Client ID typu "Web application"
# 2) Jako "Authorized redirect URI" wpisz dokladnie GOOGLE_REDIRECT_URI ponizej
# 3) Wklej Client ID/Secret tutaj, wdroz/zrestartuj serwer
# 4) Zalogowany jako wlasciciel, wejdz w przegladarce na
#    <adres-serwera>/api/calendar/auth i zatwierdz zgode Google - JEDNORAZOWO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Musi byc PUBLICZNIE dostepnym adresem (Render URL, nie localhost) i
# dokladnie zgadzac sie z tym, co wpisano w Google Cloud Console
GOOGLE_REDIRECT_URI=https://twoj-jarvis.onrender.com/api/calendar/oauth/callback

# --- Drukarka 3D (OctoPrint) ---
# Puste = "wydrukuj to" po prostu powie, ze drukarka nie jest skonfigurowana;
# plik STL zawsze mozna pobrac recznie z panelu Projekt 3D.
# Adres Twojej instancji OctoPrint, np. http://192.168.1.50:80
PRINTER_URL=
# Ustawienia -> API -> API Key w interfejsie OctoPrint
PRINTER_API_KEY=

# --- Odprawa poranna/wieczorna (push, wymaga VAPID powyzej) ---
# Miasto do pogody w odprawie (osobne od pogody w rozmowie, ktora idzie z GPS telefonu)
OWNER_CITY=Warszawa
# Godziny (czas Europe/Warsaw), w ktorych /api/cron/tick wysyla odprawe -
# tylko raz dziennie na kazda pore, w oknie kilkunastu minut od tej godziny
BRIEFING_MORNING_HOUR=7
BRIEFING_EVENING_HOUR=20

# --- Trwala pamiec ---
# WYMAGANE NA RENDERZE. Darmowy plan ma ulotny dysk: bez tego wszystko, co
# Jarvis zapamieta (fakty, zadania, przypomnienia), znika przy kazdym
# wdrozeniu i restarcie. Zaloz darmowa baze na https://upstash.com
# (Redis -> Create Database) i skopiuj oba pola z sekcji "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Nazwa uzytkownika wlasciciela (opcjonalna). Puste = logowanie samym haslem.
OWNER_USER=

# --- Sklonowany glos (tts_cloud/) ---
# Adres mikroserwisu XTTS-v2. Puste = Jarvis mowi jak dotad (Gemini/Edge).
# Do testu LOKALNEGO uzyj "http://127.0.0.1:7860", NIE "http://localhost:7860" -
# zmierzone: fetch() w Node probuje najpierw IPv6 (::1), a uvicorn nasluchuje
# tylko IPv4, wiec "localhost" konczy sie cichym ECONNREFUSED i Jarvis
# bezgłosnie wraca do starego silnika bez zadnego widocznego bledu w appce.
TTS_CLOUD_URL=
TTS_CLOUD_TOKEN=
# Powyzej tylu znakow omijamy klonowanie - na darmowym CPU jest wolniejsze
# niz ludzka mowa, wiec dluzsze wypowiedzi ida szybkim silnikiem.
TTS_CLONE_MAX_CHARS=240

# Sklonowany glos TAKZE w rozmowie na zywo (nie tylko w czacie pisanym).
# UWAGA: to realna zmiana zachowania, nie tylko "wlacznik". Gemini Live
# przestaje sam generowac dzwiek (odpowiada tekstem), a kazde zdanie idzie
# przez TTS_CLOUD_URL zanim zabrzmi - na darmowym CPU to zauwazalna cisza
# miedzy koncem wypowiedzi a poczatkiem dzwieku, nie plynne audio-w-audio
# jak domyslnie. Dziala TYLKO gdy TTS_CLOUD_URL jest tez ustawiony - sama ta
# flaga bez skonfigurowanej uslugi nic nie zmienia.
JARVIS_LIVE_CLONED_VOICE=false

# ==========================================================================
# Ponizej: konfiguracja nowych modulow (152 funkcje dodane w jednej turze).
# Kazda integracja zewnetrzna dziala wg tej samej zasady co reszta pliku:
# puste zmienne = funkcja grzecznie mowi "nie skonfigurowano", zero bledow.
# ==========================================================================

# --- Kalendarz Outlook (Microsoft Graph) - alternatywa dla Google Calendar ---
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=https://twoj-jarvis.onrender.com/api/outlook/oauth/callback

# --- Todoist - dwukierunkowa synchronizacja zadan ---
TODOIST_API_TOKEN=

# --- Google Fit - kroki/sen/tetno ---
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
GOOGLE_FIT_REDIRECT_URI=https://twoj-jarvis.onrender.com/api/googlefit/oauth/callback

# --- Integracja bankowa (open banking, np. Nordigen/GoCardless) ---
OPEN_BANKING_API_URL=
OPEN_BANKING_TOKEN=

# --- Dom / IoT (Home Assistant) ---
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
IOT_ENERGY_ANOMALY_PCT=50
IOT_SCHEDULE_TOLERANCE_MIN=10
# Alternatywny zamek, gdy NIE uzywasz Home Assistant do sterowania zamkiem
SMART_LOCK_PROVIDER=
SMART_LOCK_URL=
SMART_LOCK_TOKEN=

# --- Bezpieczenstwo (wyciek hasel/e-maili, monitoring cen i reputacji) ---
HIBP_API_KEY=
PRICE_WATCH_MIN_INTERVAL_MS=21600000
REPUTATION_MIN_INTERVAL_MS=86400000
THREAT_NOTIFY_COOLDOWN_MS=300000
RTSP_CAMERA_URLS=
RTSP_CAPTURE_TIMEOUT_MS=10000
SECURITY_LOG_SOURCES=
SECURITY_LOG_MAX=2000
LOGIN_WATCH_HOUR_TOLERANCE=2

# --- Wizja: edycja obrazu Gemini dla "jak wygladalby ten pokoj po..." ---
GEMINI_IMAGE_EDIT_MODEL=gemini-2.5-flash-image
VISION2_MONITOR_INTERVAL_MS=30000

# --- Drukarka 3D: rozszerzenia (kolejka, filament, obszar roboczy) ---
CAD_EXTRA_PRINT_POLL_MS=60000
CAD_EXTRA_BED_X_MM=220
CAD_EXTRA_BED_Y_MM=220
CAD_EXTRA_BED_Z_MM=250

# --- Komunikacja: Gmail (osobny refresh token niz Kalendarz) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://twoj-jarvis.onrender.com/api/comms/gmail/oauth/callback
# --- Komunikacja: SMS przez Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# --- Komunikacja: Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Podroze i transport ---
FLIGHTS_API_URL=
FLIGHTS_API_KEY=
FLIGHTS_CHECK_INTERVAL_MS=21600000
TRANSIT_GTFS_URL=
COMMUTE_CHECK_INTERVAL_MS=1200000
BOOKING_API_URL=
BOOKING_API_KEY=
COURIER_TRACKING_API_URL=
COURIER_TRACKING_API_KEY=
COURIER_CHECK_INTERVAL_MS=3600000
TRAVEL_SWEEP_MS=900000

# --- Rozrywka: Spotify (wyszukiwanie playlist) i TMDB (filmy/seriale) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TMDB_API_KEY=

# --- Godziny ciszy nocnej (obnizona glosnosc/ton glosu) ---
NIGHT_MODE_START_HOUR=22
NIGHT_MODE_END_HOUR=7
