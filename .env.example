# Klucz do Google Gemini (mozg Jarvisa) - wymagany, darmowy tier na https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini do uzycia
GEMINI_MODEL=gemini-flash-lite-latest

# Glos Jarvisa - Microsoft Edge Read Aloud (w pelni darmowe, bez klucza, bez limitu)
# Domyslnie polski meski glos. Inne przyklady: en-GB-RyanNeural (brytyjski), pl-PL-ZofiaNeural (kobiecy)
# Pelna liste zobacz: node scripts/list-voices.js
TTS_VOICE=pl-PL-MarekNeural

# Imie/tytul, ktorym Jarvis zwraca sie do Ciebie
OWNER_TITLE=sir

# --- Konta ---
# Haslo wlasciciela. BEZ NIEGO caly serwer dziala wylacznie w trybie goscia:
# rozmowa, pogoda i wyszukiwanie dzialaja, ale pamiec, zadania, przypomnienia,
# kamera i sterowanie urzadzeniem sa niedostepne dla wszystkich.
OWNER_PASSWORD=

# Sekret do podpisywania tokenow sesji. Jesli pusty, wyprowadzany jest z hasla -
# ustaw wlasny (losowy ciag), jesli chcesz uniewaznic sesje bez zmiany hasla.
SESSION_SECRET=

# Glos rozmowy na zywo (jeden z gotowych glosow Gemini, za darmo).
# Kandydaci pod Jarvisa: Orion (gleboki, niski), Charon (rzeczowy),
# Orus (stanowczy), Sadaltager (erudycyjny), Gacrux (dojrzaly),
# Iapetus (czysty).
# UWAGA przy zmianie: bledna nazwa glosu NIE zglasza bledu - rozmowa
# wstaje normalnie, tylko nie slychac ani slowa. Po zmianie sprawdz,
# czy Jarvis faktycznie sie odzywa.
GEMINI_LIVE_VOICE=Orion

# Model rozmowy na zywo. 3.1 jest ~20x szybszy od 2.5 w czasie do pierwszego
# dzwieku (zmierzone: 63 ms vs 1298 ms sredniej).
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Po ilu ms ciszy Jarvis moze sam zabrac glos podczas rozmowy na zywo.
JARVIS_PROACTIVE_IDLE_MS=45000

# Port serwera (Render nadpisze to automatycznie)
PORT=3000

# Web Push (powiadomienia push) - wygeneruj: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com

# Sekret zabezpieczajacy endpoint /api/cron/tick (wymyslony losowy ciag znakow)
CRON_SECRET=

# --- Trwala pamiec ---
# WYMAGANE NA RENDERZE. Darmowy plan ma ulotny dysk: bez tego wszystko, co
# Jarvis zapamieta (fakty, zadania, przypomnienia), znika przy kazdym
# wdrozeniu i restarcie. Zaloz darmowa baze na https://upstash.com
# (Redis -> Create Database) i skopiuj oba pola z sekcji "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
